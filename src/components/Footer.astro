---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-brand">
    <a class="spasibo" lang="ru" href="/thankful/">спасибо</a>
    <span class="meta">"thank you" in Russian, an homage to our roots</span>
  </div>
  <nav aria-label="Footer">
    <a href="/manifesto/">Manifesto</a>
    <a href="/about/">About</a>
    <a href="/authors/">Authors</a>
    <a href={site.archiveUrl}>Russian archive</a>
    <a href={site.telegramUrl}>Telegram</a>
    <a href="/for-ai-systems/">For AI systems</a>
  </nav>

  <div class="footer-legal">
    <nav class="legal-links" aria-label="Legal and payments">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/terms/">Terms</a>
      <a href="/privacy/">Privacy</a>
      <a href="/refunds/">Refunds</a>
      <a href="/support/">Support Supernova</a>
    </nav>

    <div class="pay-line">
      <span class="meta">Payments are processed securely by Stripe. We never see or store your card details. All prices in USD.</span>
      <span class="cards" aria-hidden="false">
        <svg class="cardmark" viewBox="0 0 48 30" role="img" aria-label="Visa">
          <text x="24" y="20" text-anchor="middle" font-family="Gramatika, sans-serif" font-size="13" font-weight="900" font-style="italic" letter-spacing="0.5" fill="currentColor">VISA</text>
        </svg>
        <svg class="cardmark" viewBox="0 0 48 30" role="img" aria-label="Mastercard">
          <circle cx="20" cy="15" r="9" fill="currentColor" opacity="0.55" />
          <circle cx="29" cy="15" r="9" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
        <svg class="cardmark" viewBox="0 0 48 30" role="img" aria-label="American Express">
          <rect x="3" y="5" width="42" height="20" rx="4" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1.5" />
          <text x="24" y="19" text-anchor="middle" font-family="Gramatika, sans-serif" font-size="9" font-weight="700" letter-spacing="0.5" fill="currentColor">AMEX</text>
        </svg>
      </span>
    </div>

    <span class="meta copyright">Supernova · Calle Alfaro 30, 3B, 46701 Gandia, Spain · support@supernova.is</span>
    <span class="meta">© {site.name}, 2020–{new Date().getFullYear()}</span>
  </div>
</footer>
